# Copy to .env.local for development. For production, use Firebase App Hosting
# environment variables / secrets (see apphosting.yaml).

# Firebase: backend env vars apply at RUNTIME only after you redeploy / roll out a new revision.
# Configure them in Firebase Console (App Hosting → Environment). Do not duplicate the same keys in
# apphosting.yaml while they exist in the console — rollouts can fail with a duplicate-key error.

# --- Gmail / SMTP (Nodemailer) ---
# Use an App Password (not your normal Gmail password): Google Account → Security →
# 2-Step Verification → App passwords → generate one for "Mail".
# Accepted aliases for the password: SMTP_PASS (recommended), SMTP_PASSWORD,
# GMAIL_APP_PASSWORD, or EMAIL_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hugoblouin@gmail.com
SMTP_PASS=

# "From" address (must match SMTP_USER for Gmail in most cases).
SMTP_FROM=hugoblouin@gmail.com

# Recipients for RSVP notifications (comma-separated). Defaults to Hugo + Lina if omitted.
RSVP_NOTIFY_EMAIL=hugoblouin@gmail.com,moussadek.lina45@gmail.com

# Optional: CC on each RSVP notification.
# RSVP_CC_EMAIL=
